    "/campaigns/{campaign_id}/podcasts": {
      "get": {
        "operationId": "listCampaignRecords",
        "summary": "List campaign outreach records",
        "description": "Read outreach records, pitch status, timestamps, and disclosed contact details. The historical route and response array use the name podcasts, but support podcast, journalist, newsletter, person, and guest records. Use has_more, limit, and offset to paginate.",
        "tags": [
          "Outreach records"
        ],
        "parameters": [
          {
            "name": "campaign_id",
            "in": "path",
            "required": true,
            "description": "Campaign ID from List campaigns.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Pitch status.",
            "schema": {
              "type": "string",
              "enum": [
                "not_sent",
                "in_progress",
                "replied",
                "paused",
                "skipped",
                "finished",
                "booked",
                "appeared",
                "opened"
              ]
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Record type.",
            "schema": {
              "type": "string",
              "enum": [
                "podcast",
                "journalist",
                "newsletter",
                "person",
                "guest"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Records per page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 250,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Records to skip.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. Fields respect team and profile access and account disclosure settings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "campaign_id": {
                      "type": "integer"
                    },
                    "campaign_name": {
                      "type": "string"
                    },
                    "total_podcasts": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    },
                    "has_more": {
                      "type": "boolean"
                    },
                    "podcasts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {}
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or revoked PodPitch API key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {}
                  }
                }
              }
            }
          },
          "403": {
            "description": "Integration access is not enabled for this account.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {}
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found or outside the key profile scope.",
            "content": {
              "application/json": {
