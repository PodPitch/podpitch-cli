    "/pitches": {
      "get": {
        "operationId": "listSentPitches",
        "summary": "List sent pitch events",
        "description": "Requires enabled PodPitch integration access. Returns events for recipients previously pitched through PodPitch. One page per request.",
        "tags": [
          "Pitches and replies"
        ],
        "parameters": [
          {
            "name": "campaign_id",
            "in": "query",
            "required": false,
            "description": "Restrict to one campaign.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Records per page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Records to skip.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          },
          {
            "name": "as_of",
            "in": "query",
            "required": false,
            "description": "Optional upper event timestamp cutoff for pagination. Use an ISO timestamp with a timezone.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. Fields respect team and profile access and account disclosure settings.",
            "content": {
