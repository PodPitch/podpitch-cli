{
  "openapi": "3.0.3",
  "info": {
    "title": "PodPitch",
    "version": "1.0.0",
    "description": "Connect PodPitch campaign reporting and media outreach data to your own tools. Bring your own PodPitch API key. An eligible PodPitch account is required; a free RapidAPI plan does not include a PodPitch subscription or outreach credits.",
    "contact": {
      "name": "PodPitch",
      "url": "https://www.podpitch.com"
    },
    "x-website": "https://www.podpitch.com",
    "x-category": "Business Software",
    "license": {
      "name": "MIT (API definition only)",
      "url": "https://github.com/PodPitch/podpitch-cli/blob/main/LICENSE"
    }
  },
  "servers": [
    {
      "url": "https://api.podpitch.com/api/v1",
      "description": "PodPitch production public API"
    }
  ],
  "externalDocs": {
    "description": "PodPitch API keys and account documentation",
    "url": "https://app.podpitch.com/settings/api"
  },
  "tags": [
    {
      "name": "Campaigns",
      "description": "Campaign reporting and statistics."
    },
    {
      "name": "Outreach records",
      "description": "Individual media outreach records and pitch status."
    },
    {
      "name": "Pitches and replies",
      "description": "Read sent pitch and reply events with enabled integration access."
    }
  ],
  "security": [
    {
      "PodPitchApiKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "PodPitchApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Required. Enter Bearer followed by your own PodPitch API key, for example: Bearer pp_your_api_key_here. Never use another customer's key. RapidAPI credentials are separate and do not replace the PodPitch key."
      }
    }
  },
  "paths": {
    "/campaigns": {
      "get": {
        "operationId": "listCampaigns",
        "summary": "List campaigns",
        "description": "List campaigns, profile information, and outreach statistics available to your API key.",
        "tags": [
          "Campaigns"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Campaign status.",
            "schema": {
              "type": "string",
              "enum": [
                "Active",
                "Manual",
                "Off",
                "Archived"
              ]
            }
          },
          {
            "name": "profile",
            "in": "query",
            "required": false,
            "description": "Partial profile name. A profile-restricted key retains its existing scope.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. Fields respect team and profile access and account disclosure settings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "total_campaigns": {
                      "type": "integer"
                    },
                    "campaigns": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {}
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or revoked PodPitch API key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {}
                  }
                }
              }
            }
          },
          "403": {
            "description": "Integration access is not enabled for this account.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {}
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found or outside the key profile scope.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {}
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid request parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {}
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit reached.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {}
                  }
                }
              }
            }
          }
        }
      }
    },
